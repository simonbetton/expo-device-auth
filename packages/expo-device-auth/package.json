{
  "name": "expo-device-auth",
  "version": "0.0.0",
  "description": "Expo-first local device authentication with biometrics and encrypted PIN fallback.",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "app.plugin.js",
    "src/*.ts",
    "src/*.tsx",
    "lib/commonjs/*.js",
    "lib/commonjs/*.js.map",
    "lib/commonjs/package.json",
    "lib/module/*.js",
    "lib/module/*.js.map",
    "lib/typescript/*.d.ts",
    "lib/typescript/*.d.ts.map"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@expo/config-plugins": "^58.0.11",
    "@noble/hashes": "^2.4.0",
    "expo-build-properties": "~58.0.12",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@react-native/js-polyfills": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "expo": "^58.0.22",
    "expo-local-authentication": "^58.0.2",
    "expo-secure-store": "^58.0.2",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": ">=58 <59",
    "expo-local-authentication": ">=58 <59",
    "expo-secure-store": ">=58 <59",
    "react": ">=19.3.0",
    "react-native": ">=0.88 <0.89"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
