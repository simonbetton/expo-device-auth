{
  "name": "expo-device-auth",
  "version": "0.0.0",
  "description": "Expo-first local device authentication with biometrics and encrypted PIN fallback.",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "app.plugin.js",
    "src/*.ts",
    "src/*.tsx",
    "lib/commonjs/*.js",
    "lib/commonjs/*.js.map",
    "lib/commonjs/package.json",
    "lib/module/*.js",
    "lib/module/*.js.map",
    "lib/typescript/*.d.ts",
    "lib/typescript/*.d.ts.map"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@expo/config-plugins": ">=55 <57",
    "@noble/hashes": "^1.8.0",
    "expo-build-properties": "~55.0.14",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-quick-base64": "^3.0.0",
    "react-native-quick-crypto": "^1.1.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@react-native/js-polyfills": "^0.83.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.16",
    "expo": "~55.0.26",
    "expo-local-authentication": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.41.0",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "expo": ">=55 <57",
    "expo-local-authentication": ">=55 <57",
    "expo-secure-store": ">=55 <57",
    "react": ">=19.2.0",
    "react-native": ">=0.83 <0.85"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
