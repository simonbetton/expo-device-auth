{
  "name": "expo-device-auth-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter expo-device-auth build",
    "test": "pnpm --filter expo-device-auth test",
    "test:coverage": "pnpm --filter expo-device-auth test:coverage",
    "typecheck:package": "pnpm --filter expo-device-auth typecheck",
    "typecheck:example": "pnpm --filter expo-device-auth-example typecheck",
    "typecheck": "pnpm typecheck:package && pnpm build && pnpm typecheck:example",
    "verify": "pnpm test:coverage && pnpm typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "fallow": "^3.38.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "ultracite": "8.1.1"
  },
  "packageManager": "pnpm@11.3.0"
}
